{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Read(~/AppData/Roaming/Microsoft/Windows/PowerShell/PSReadLine/**)",
      "Read(~/.flightdeck-release/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.ts\"; [ -f \"$f\" ] || exit 0; bun \"$f\"",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/biome-on-edit.ts\"; [ -f \"$f\" ] || exit 0; bun \"$f\"",
            "timeout": 30,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ts\"; [ -f \"$f\" ] || exit 0; bun \"$f\"",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
