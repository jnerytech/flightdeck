{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flightdeck",
  "version": "../package.json",
  "identifier": "dev.flightdeck.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Flightdeck",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws: wss: ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src http://127.0.0.1:* http://localhost:* https://127.0.0.1:* https://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["flightdeck"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFNTAyODNBOTFERkRBQTcKUldTbjJ0K1JPaWhRZmlMTmpaaW5KTys4b1IyeFVhRnorWDlBeEJCN1l4Z3lveC9MSGN0K0FKaGgK",
      "endpoints": ["https://github.com/jnerytech/flightdeck/releases/latest/download/latest.json"]
    }
  }
}
