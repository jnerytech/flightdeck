{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "scripts/test/{fake-cli,sleeping-git}-main.ts",
        "scripts/test/{coverage-funcs-preload,git-env-probe,temp-run-fixture}.ts",
        "scripts/test/fixtures/istanbul-serialize/serialized.fixture.ts",
        "scripts/e2e/bdd/{fixtures,steps}.ts"
      ],
      "project": ["scripts/**/*.ts"],
      "ignoreBinaries": ["gpg"],
      "ignoreDependencies": ["@stryker-mutator/command-runner"]
    },
    "apps/daemon": {
      "entry": [
        "test/{runtime/fake-opencode,support/fake-claude}-main.ts",
        "test/fixtures/mcp/{eco,mudo}-server.ts"
      ]
    },
    "apps/desktop": {
      "ignore": ["src/components/ui/**"],
      "entry": ["src/main.web.tsx", "test/i18n-types.ts"]
    },
    "packages/protocol": {}
  }
}
