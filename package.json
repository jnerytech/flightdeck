{
  "name": "flightdeck",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "layout:ratchet": "bun run scripts/layout-ratchet.ts",
    "bundle:budget": "bun run scripts/bundle-budget.ts",
    "perf:baseline": "bun run scripts/perf-baseline.ts",
    "test": "bun test && bun run scripts/check-coverage.ts",
    "coverage": "bun test && bun run scripts/check-coverage.ts",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:real": "bun run scripts/smoke.ts --real",
    "smoke:multi": "bun run scripts/smoke-multi.ts",
    "smoke:history": "bun run scripts/smoke-history.ts",
    "smoke:board": "bun run scripts/smoke-board.ts",
    "smoke:central": "bun run scripts/smoke-central.ts",
    "smoke:workflow": "bun run scripts/smoke-workflow.ts",
    "smoke:ops": "bun run scripts/smoke-ops.ts",
    "smoke:limits": "bun run scripts/smoke-limits.ts",
    "smoke:update": "bun run scripts/smoke-update.ts",
    "smoke:costs": "bun run scripts/smoke-costs.ts",
    "smoke:review": "bun run scripts/smoke-review.ts",
    "smoke:vault": "bun run scripts/smoke-vault.ts",
    "smoke:actions": "bun run scripts/smoke-actions.ts",
    "smoke:rules-vault": "bun run scripts/smoke-rules-vault.ts",
    "smoke:teams": "bun run scripts/smoke-teams.ts",
    "smoke:automation": "bun run scripts/smoke-automation.ts",
    "smoke:checkpoints": "bun run scripts/smoke-checkpoints.ts",
    "smoke:terminal": "bun run scripts/smoke-terminal.ts",
    "smoke:run": "bun run scripts/smoke-run.ts",
    "smoke:ssh": "bun run scripts/smoke-ssh.ts",
    "smoke:snippets": "bun run scripts/smoke-snippets.ts",
    "smoke:personas": "bun run scripts/smoke-personas.ts",
    "smoke:watch": "bun run scripts/smoke-watch.ts",
    "smoke:perf": "bun run scripts/smoke-perf.ts",
    "tdd:audit": "bun run scripts/tdd-audit.ts",
    "demo": "bun run scripts/demo.ts",
    "demo:shots": "bun run scripts/demo.ts --shots",
    "e2e": "bun run scripts/demo.ts --e2e",
    "ui:lock": "bun run scripts/ui-lock.ts",
    "build:daemon": "bun run scripts/build-daemon.ts",
    "build:desktop": "bun run --filter @flightdeck/desktop build",
    "deploy": "bun run scripts/deploy.ts",
    "release:version": "bun run scripts/release-version.ts",
    "release:assets": "bun run scripts/release-assets.ts",
    "release:tauri-config": "bun run scripts/release-tauri-config.ts",
    "release:sign": "bun run scripts/release-sign.ts"
  },
  "dependencies": {
    "@flightdeck/protocol": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "@types/pngjs": "6.0.5",
    "axe-core": "4.10.2",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "typescript": "7.0.2"
  }
}
