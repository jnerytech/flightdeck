{
  "name": "flightdeck",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:real": "bun run scripts/smoke.ts --real",
    "build:daemon": "bun run scripts/build-daemon.ts",
    "build:desktop": "bun run --filter @flightdeck/desktop build"
  },
  "dependencies": {
    "@flightdeck/protocol": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
